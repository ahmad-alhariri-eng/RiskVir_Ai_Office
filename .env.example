# OfficeAI Pro — Environment Configuration
# Copy this file to .env and edit as needed.
# Do NOT commit .env to version control.

# ── Model Configuration ──────────────────────────────────────────
# Override the auto-detected model path (optional).
# If not set, the backend will find the first .gguf in models/ dir.
# OFFICEAI_MODEL_PATH=C:\path\to\your\model.gguf

# ── Server Configuration ─────────────────────────────────────────
# Host and port the backend listens on.
OFFICEAI_HOST=127.0.0.1
OFFICEAI_PORT=8000

# ── SSL Configuration ────────────────────────────────────────────
# Paths to SSL cert and key for HTTPS.
# If not set, the server starts in HTTP mode.
# OFFICEAI_SSL_CERTFILE=C:\Users\YourName\.office-addin-dev-certs\localhost.crt
# OFFICEAI_SSL_KEYFILE=C:\Users\YourName\.office-addin-dev-certs\localhost.key

# ── LLM Engine Settings ──────────────────────────────────────────
# Number of CPU threads for llama.cpp inference.
OFFICEAI_N_THREADS=8

# Context window size (tokens).
OFFICEAI_N_CTX=4096

# Max tokens to generate per response.
OFFICEAI_MAX_TOKENS=16384
